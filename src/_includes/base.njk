<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}{% if pageTitle %} — {% endif %}jorm.objects</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="nav">
    <a href="/" class="nav__logo">jorm.objects</a>
    <ul class="nav__links">
      <li><a href="/work/"{% if navSection == "work" %} class="active"{% endif %}>Work</a></li>
      <li><a href="/shop/"{% if navSection == "shop" %} class="active"{% endif %}>Shop</a></li>
      <li><a href="/about/"{% if navSection == "about" %} class="active"{% endif %}>About</a></li>
      <li><a href="/contact/"{% if navSection == "contact" %} class="active"{% endif %}>Contact</a></li>
    </ul>
    <button class="nav__hamburger" aria-label="Menu">&#9776;</button>
  </nav>

  <div class="nav__overlay">
    <button class="nav__close" aria-label="Close">&times;</button>
    <a href="/work/">Work</a>
    <a href="/shop/">Shop</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
  </div>

  {{ content | safe }}

  <footer class="footer">
    <span>&copy; {{ site.year }} jorm.objects</span>
    <ul class="footer__links">
      <li><a href="{{ contact.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
    </ul>
  </footer>

  <script>
    document.querySelector('.nav__hamburger').addEventListener('click', () => {
      document.querySelector('.nav__overlay').classList.add('open');
    });
    document.querySelector('.nav__close').addEventListener('click', () => {
      document.querySelector('.nav__overlay').classList.remove('open');
    });
  </script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</body>
</html>
