<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}{% if pageTitle %} — {% endif %}jorm.objects</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="{{ design.fonts.bodyUrl }}" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style id="design-tokens">
    :root {
      --bg: {{ design.colors.bg }};
      --text: {{ design.colors.text }};
      --accent: {{ design.colors.accent }};
      --border: {{ design.colors.border }};
      --font: '{{ design.fonts.body }}', monospace;
    }
  </style>
</head>
<body>
  <nav class="nav">
    <a href="/" class="nav__logo" aria-label="jorm.objects home"><span>jorm</span><span class="nav__dot">.</span><span>objects</span></a>
    <ul class="nav__links">
      <li><a href="/work/"{% if navSection == "work" %} class="active"{% endif %}>Work</a></li>
      <li><a href="/shop/"{% if navSection == "shop" %} class="active"{% endif %}>Shop</a></li>
      <li><a href="/about/"{% if navSection == "about" %} class="active"{% endif %}>About</a></li>
      <li><a href="/contact/"{% if navSection == "contact" %} class="active"{% endif %}>Contact</a></li>
    </ul>
    <div class="nav__meta">Antwerp, BE<br>Est. 2021</div>
    <button class="nav__hamburger" aria-label="Open menu"><span></span><span></span></button>
  </nav>

  <div class="nav__overlay">
    <button class="nav__close" aria-label="Close">&times;</button>
    <a href="/work/">Work</a>
    <a href="/shop/">Shop</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
  </div>

  {{ content | safe }}

  <footer class="footer">
    <a href="/" class="footer__mark">jorm<span>.</span><br>objects</a>
    <div class="footer__message">Objects with a point of view.<br>Made for considered spaces.</div>
    <div class="footer__utility">
      <span>&copy; {{ site.year }} jorm.objects</span>
      <a href="{{ contact.instagram }}" target="_blank" rel="noopener">Instagram ↗</a>
    </div>
  </footer>

  <script>
    document.querySelector('.nav__hamburger').addEventListener('click', () => {
      document.querySelector('.nav__overlay').classList.add('open');
    });
    document.querySelector('.nav__close').addEventListener('click', () => {
      document.querySelector('.nav__overlay').classList.remove('open');
    });
  </script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    // Design Studio live preview bridge
    window.addEventListener('message', (e) => {
      if (e.origin !== 'http://localhost:8082') return;

      if (e.data.type === 'design-update') {
        const { colors, font, fontUrl } = e.data;
        const style = document.getElementById('design-tokens');
        if (style) {
          style.textContent = `:root { --bg:${colors.bg};--text:${colors.text};--accent:${colors.accent};--border:${colors.border};--font:'${font}',monospace; }`;
        }
        let link = document.getElementById('studio-font-link');
        if (!link) {
          link = document.createElement('link');
          link.id = 'studio-font-link';
          link.rel = 'stylesheet';
          document.head.appendChild(link);
        }
        link.href = fontUrl;
      }

      if (e.data.type === 'sections-update') {
        const order = e.data.sections;
        const main = document.querySelector('main');
        if (!main) return;
        const map = {};
        main.querySelectorAll('[data-section]').forEach(el => {
          map[el.dataset.section] = el;
          el.style.display = 'none';
        });
        for (const sec of order) {
          const el = map[sec.id];
          if (!el) continue;
          el.style.display = sec.visible ? '' : 'none';
          if (sec.visible) main.appendChild(el);
        }
      }
    });

    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
