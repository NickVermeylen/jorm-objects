---
layout: base.njk
pageTitle: Contact
navSection: contact
permalink: /contact/
---
<main>
  <div class="page-header">
    <h1>Contact</h1>
  </div>

  <section class="contact">
    <form class="contact__form" name="contact" method="POST" data-netlify="true">
      <div class="form__group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div class="form__group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form__group">
        <label for="subject">Subject</label>
        <select id="subject" name="subject">
          <option value="general">General Inquiry</option>
          <option value="purchase">Purchase Inquiry</option>
          <option value="collaboration">Collaboration</option>
          <option value="press">Press</option>
        </select>
      </div>
      <div class="form__group">
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button type="submit" class="form__submit">Send Message &rarr;</button>
    </form>

    <div class="contact__info">
      <h2>Studio</h2>
      <p>{{ contact.name }}<br>{{ contact.street }}<br>{{ contact.city }}<br>{{ contact.country }}</p>
      <p><a href="{{ contact.emailHref }}">{{ contact.email }}</a></p>
      <p><a href="{{ contact.instagram }}" target="_blank" rel="noopener">{{ contact.instagramHandle }}</a></p>
    </div>
  </section>
</main>

<script>
  const params = new URLSearchParams(window.location.search);
  const piece = params.get('piece');
  if (piece) {
    const subject = document.querySelector('#subject');
    subject.value = 'purchase';
    const message = document.querySelector('#message');
    message.value = 'I am interested in: ' + piece;
    message.focus();
  }
</script>
